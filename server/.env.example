# Server env — copy to server/.env

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/alugridx

# Secret used to sign admin JWTs — generate a long random string in production
JWT_SECRET=replace-me-with-a-long-random-string

# Admin bootstrap (used only by createAdmin.js to create the first admin user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me-with-a-strong-password

# API port (frontend NEXT_PUBLIC_API_URL must match)
PORT=5001

# Comma-separated origins allowed by CORS in production.
# In dev (NODE_ENV != production) all origins are allowed automatically.
# Example: ALLOWED_ORIGINS=https://alugridx-website.vercel.app,https://www.alugridx.com
ALLOWED_ORIGINS=

# Email notifications (optional — leave blank to disable)
# Use either SMTP_* OR GMAIL_* — not both
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

GMAIL_USER=
GMAIL_PASS=

# Where enquiry notifications are delivered
ENQUIRY_TO=info@alugridx.com

# Cloudinary — image uploads for products, projects, blog covers, technical drawings
# Create a free account at https://cloudinary.com and copy from the dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
